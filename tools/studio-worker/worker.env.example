# Copie para worker.env (fica fora do git) e preencha. A chave é a mesma da variável Studio__WorkerKey do Railway.
ROOTBOOST_API=https://rootboost-production.up.railway.app
ROOTBOOST_WORKER_KEY=
STUDIO_WORKER_ID=pc-matheus

# Onde estão os projetos (projetos/, brutos/, finais/) e as ferramentas do pipeline.
STUDIO_BASE=C:/Users/devma/Videos/MedlyCare Reels
STUDIO_TOOLS=C:/Users/devma/Documents/MedlyCare Marketing/ferramentas

# Pipeline: executável e argumentos. {nome} {voz} {seed} {tools} {base} são trocados por job.
# Padrão: node {tools}/narrado-calmo.mjs {nome} --voz {voz} --semente {seed}
# STUDIO_PIPELINE_BIN=
# STUDIO_PIPELINE_ARGS=
STUDIO_DEFAULT_VOICE=matheus2b
STUDIO_POLL_SECONDS=60
