# RootBoost — referência de variáveis de ambiente.
# ASP.NET não carrega .env automaticamente. Use estes nomes no launch profile, no shell,
# ou nas Variables do Railway. Config em seção usa "__" (duplo sublinhado). NUNCA commitar valores reais.

# --- Modo dos adapters (dev usa Mock/Logging/Test; prod usa Cj/Resend/PayPal) ---
Supplier=Cj                    # Cj | Mock
Notifier=Resend                # Resend | Logging
Payments__Verifier=PayPal      # PayPal | Test

# --- Banco (volume persistente em prod) ---
ConnectionStrings__Sqlite=Data Source=/data/rootboost.db

# --- CJ Dropshipping ---
Cj__Email=voce@exemplo.com
Cj__ApiKey=coloque-a-api-key-da-cj
# O VID (id de variante) de cada produto vai no catalog.json, campo supplierVariantId.

# --- PayPal ---
# Sandbox (teste, sem dinheiro real): https://api-m.sandbox.paypal.com
# Produção (dinheiro real):          https://api-m.paypal.com
PayPal__BaseUrl=https://api-m.sandbox.paypal.com
PayPal__ClientId=coloque-o-client-id
PayPal__ClientSecret=coloque-o-secret
PayPal__WebhookId=coloque-o-webhook-id      # só necessário pro /webhook/payment (rede de segurança)

# --- Resend (e-mail transacional). Sem isso, use Notifier=Logging pra testar. ---
Resend__ApiKey=re_xxxxxxxx
Resend__FromEmail=pedidos@seu-dominio.com
Resend__FromName=RootBoost
Resend__OperatorEmail=voce@exemplo.com      # inbox que recebe alertas de falha de fulfillment

# --- API ---
Orders__ApiKey=uma-chave-forte-pro-GET-/orders
Cors__AllowedOrigins=https://sua-landing.com,https://outra-origem.com   # vazio = libera qualquer origem (dev)
Features__Stripe=false

# --- Conversões / tráfego pago (Meta CAPI). Null por padrão (desligado). ---
Tracker=Null                       # Null | Meta
Meta__PixelId=                     # id do Pixel (Events Manager)
Meta__AccessToken=                 # token da Conversions API
Meta__ApiVersion=v21.0
# Meta__TestEventCode=TEST12345    # opcional, pra depurar em Test Events sem sujar os dados

# PORT é injetado pela plataforma (Railway/Render/Fly) — não precisa setar manualmente.
