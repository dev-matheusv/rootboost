<?xml version="1.0" encoding="utf-8"?>
<!-- Root.IA (19/11): pacotes Root.Ia.* vêm do GitHub Packages privado; o resto do nuget.org.
     O token vem da variável ROOTIA_PACKAGES_TOKEN (PC, secret do Actions, variável do Railway), nunca daqui. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="root-ia" value="https://nuget.pkg.github.com/dev-matheusv/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="root-ia">
      <package pattern="Root.Ia.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <root-ia>
      <add key="Username" value="dev-matheusv" />
      <add key="ClearTextPassword" value="%ROOTIA_PACKAGES_TOKEN%" />
    </root-ia>
  </packageSourceCredentials>
</configuration>
